# --- Storage ---------------------------------------------------------------
# Local dev without MongoDB: memory://  (in-process mongomock, wiped on restart)
# Docker compose: mongodb://mongo:27017
# Production: your MongoDB Atlas SRV string
MONGODB_URI=memory://
MONGODB_DB=climate_hazards
ANALYSIS_CACHE_TTL_DAYS=7

# --- Data ------------------------------------------------------------------
# open-meteo (real ERA5) | synthetic (offline demo, clearly labelled in the UI)
DATA_SOURCE=open-meteo
CONTACT_EMAIL=you@example.com   # sent in the User-Agent (Nominatim policy)
UPSTREAM_MAX_CONCURRENCY=2
FETCH_CHUNK_YEARS=20

# --- HTTP / security ---------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Number of reverse proxies in front of the API (Render = 1). 0 = ignore X-Forwarded-For.
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_ANALYZE=20/minute
RATE_LIMIT_EXPORT=10/minute
RATE_LIMIT_GEOCODE=30/minute
